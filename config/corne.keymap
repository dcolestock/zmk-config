#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#include "../zmk-nodefree-config/helper.h"
#include "../zmk-nodefree-config/keypos_def/keypos_42keys.h"

/* layer and key shortcuts */

#define __ &none

#define DEF 0  // layer shortcuts, must match order in which they are defined below
#define NAV 1
#define MEDIA 2
#define NUM 3
#define SYM 4
#define FUN 5
#define GamingBase 6
#define Gaming1 7
#define Gaming2 8

/* custom behaviors */

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // left-hand keys
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // right-hand keys
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // thumb keys

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_BEHAVIOR(NAME, hold_tap, \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)  // left-hand HRMs
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)  // right-hand HRMs


#define MIRYOKU_SHIFT_FUNCTION(NAME, BINDING, SHIFT_BINDING) \
    ZMK_BEHAVIOR(NAME, mod_morph, \
        bindings = <BINDING>, <SHIFT_BINDING>; \
        mods = <(MOD_LSFT|MOD_RSFT)>; \
    )

#define MIRYOKU_SHIFT_MACRO(NAME, BINDING, SHIFT_BINDING) \
    ZMK_BEHAVIOR(u_macro_ ## NAME, macro, \
        wait-ms = <0>; \
        bindings = <SHIFT_BINDING>; \
    ) \
    MIRYOKU_SHIFT_FUNCTION(NAME, BINDING, &u_macro_ ## NAME)

MIRYOKU_SHIFT_MACRO(u_bt_sel_0, &bt BT_SEL 0, &bt BT_SEL 0 &bt BT_CLR)
MIRYOKU_SHIFT_MACRO(u_bt_sel_1, &bt BT_SEL 1, &bt BT_SEL 1 &bt BT_CLR)
MIRYOKU_SHIFT_MACRO(u_bt_sel_2, &bt BT_SEL 2, &bt BT_SEL 2 &bt BT_CLR)
MIRYOKU_SHIFT_MACRO(u_bt_sel_3, &bt BT_SEL 3, &bt BT_SEL 3 &bt BT_CLR)
MIRYOKU_SHIFT_MACRO(u_bt_sel_4, &bt BT_SEL 4, &bt BT_SEL 4 &bt BT_CLR)

MIRYOKU_SHIFT_FUNCTION(u_out_tog, &out OUT_TOG, &out OUT_USB)

MIRYOKU_SHIFT_FUNCTION(u_caps_word, &caps_word, &kp CAPS)

MIRYOKU_SHIFT_FUNCTION(u_rgb_tog, &rgb_ug RGB_TOG, &rgb_ug RGB_OFF)
MIRYOKU_SHIFT_FUNCTION(u_rgb_eff, &rgb_ug RGB_EFF, &rgb_ug RGB_EFR)
MIRYOKU_SHIFT_FUNCTION(u_rgb_hui, &rgb_ug RGB_HUI, &rgb_ug RGB_HUD)
MIRYOKU_SHIFT_FUNCTION(u_rgb_sai, &rgb_ug RGB_SAI, &rgb_ug RGB_SAD)
MIRYOKU_SHIFT_FUNCTION(u_rgb_bri, &rgb_ug RGB_BRI, &rgb_ug RGB_BRD)
// MIRYOKU_SHIFT_FUNCTION(u_ep_tog, &ext_power EP_TOG, &ext_power EP_OFF) - init priority bug

/* combos */
#undef COMBO_TERM
#define COMBO_TERM 40  // timeout of 40ms (default is 30ms if omitted)
// ZMK_COMBO(gaming_layer,  &to GamingBase, 4 5, BASE)

/* keymap */
/* format:
 xxxxxx xxxxxx
 xxxxxx xxxxxx
 xxxxxx xxxxxx
    xxx xxx
*/

ZMK_LAYER(default_layer,
// ╭───┬────────────┬────────────┬─────────────┬─────────────┬────────╮  ╭────────────┬─────────────┬─────────────┬────────────┬────────────┬───╮
    __  &kp SQT      &kp COMMA    &kp DOT       &kp P         &kp Y       &kp F        &kp G         &kp C         &kp R        &kp L        __
// ├───┼────────────┼────────────┼─────────────┼─────────────┼────────┤  ├────────────┼─────────────┼─────────────┼────────────┼────────────┼───┤
    __  &hml LGUI A  &hml LALT O  &hml LCTRL E  &hml LSHFT U  &kp I       &kp D        &hmr LSHFT H  &hmr LCTRL T  &hmr LALT N  &hmr LGUI S  __
// ├───┼────────────┼────────────┼─────────────┼─────────────┼────────┤  ├────────────┼─────────────┼─────────────┼────────────┼────────────┼───┤
    __  &kp SLASH    &kp Q        &kp J         &kp K         &kp X       &kp B        &kp M         &kp W         &kp V        &kp Z        __
// ╰───┴────────────┴────────────┼─────────────┼─────────────┼────────┤  ├────────────┼─────────────┼─────────────┼────────────┴────────────┴───╯
                                  &lt FUN DEL   &mo NUM       &mo SYM     &key_repeat  &lt NAV SPC   &mo MEDIA
//                               ╰─────────────┴─────────────┴────────╯  ╰────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(nav_layer,
// ╭───┬──────────┬──────────┬──────────┬──────────┬─────────────╮  ╭───┬──────────┬──────────┬─────────┬─────────┬───╮
    __  &kp PG_UP  &kp HOME   &kp UP     &kp END    &kp INS          __  &kp RET    &kp ESC    __        __        __
// ├───┼──────────┼──────────┼──────────┼──────────┼─────────────┤  ├───┼──────────┼──────────┼─────────┼─────────┼───┤
    __  &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &u_caps_word     __  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  __
// ├───┼──────────┼──────────┼──────────┼──────────┼─────────────┤  ├───┼──────────┼──────────┼─────────┼─────────┼───┤
    __  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)        __  __         __         __        __        __
// ╰───┴──────────┴──────────┼──────────┼──────────┼─────────────┤  ├───┼──────────┼──────────┼─────────┴─────────┴───╯
                              &kp DEL    &kp BSPC   &kp TAB          __  __         __
//                           ╰──────────┴──────────┴─────────────╯  ╰───┴──────────┴──────────╯
)

ZMK_LAYER(media_layer,
// ╭───┬────────────┬────────────┬─────────────┬────────────┬──────────────────╮  ╭───┬──────────┬──────────┬─────────┬─────────┬───╮
    __  &u_rgb_hui   &u_rgb_sai   &kp C_VOL_UP  &u_rgb_bri   &u_rgb_tog            __  __         __         __        __        __
// ├───┼────────────┼────────────┼─────────────┼────────────┼──────────────────┤  ├───┼──────────┼──────────┼─────────┼─────────┼───┤
    __  &u_rgb_eff   &kp C_PREV   &kp C_VOL_DN  &kp C_NEXT   &ext_power EP_TOG     __  &kp LSHFT  &kp LCTRL  &kp LALT  &kp LGUI  __
// ├───┼────────────┼────────────┼─────────────┼────────────┼──────────────────┤  ├───┼──────────┼──────────┼─────────┼─────────┼───┤
    __  &u_bt_sel_0  &u_bt_sel_1  &u_bt_sel_2   &u_bt_sel_3  &u_out_tog            __  __         __         __        __        __
// ╰───┴────────────┴────────────┼─────────────┼────────────┼──────────────────┤  ├───┼──────────┼──────────┼─────────┴─────────┴───╯
                                  &kp C_MUTE    &kp C_PP     &kp C_STOP            __  __         __
//                               ╰─────────────┴────────────┴──────────────────╯  ╰───┴──────────┴──────────╯
)

ZMK_LAYER(num_layer,
// ╭───┬─────────┬─────────┬──────────┬──────────┬───╮  ╭──────────┬──────────┬──────────┬──────────┬──────────┬───╮
    __  __        &kp DEL   &kp BKSP   &kp TAB    __     &kp LBKT   &kp NUM_7  &kp NUM_8  &kp NUM_9  &kp RBKT   __
// ├───┼─────────┼─────────┼──────────┼──────────┼───┤  ├──────────┼──────────┼──────────┼──────────┼──────────┼───┤
    __  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  __     &kp EQL    &kp NUM_4  &kp NUM_5  &kp NUM_6  &kp SEMI   __
// ├───┼─────────┼─────────┼──────────┼──────────┼───┤  ├──────────┼──────────┼──────────┼──────────┼──────────┼───┤
    __  __        __        __         __         __     &kp BSLH   &kp NUM_1  &kp NUM_2  &kp NUM_3  &kp GRAVE  __
// ╰───┴─────────┴─────────┼──────────┼──────────┼───┤  ├──────────┼──────────┼──────────┼──────────┴──────────┴───╯
                            __         __         __     &kp MINUS  &kp NUM_0  &kp DOT
//                         ╰──────────┴──────────┴───╯  ╰──────────┴──────────┴──────────╯
)

ZMK_LAYER(sym_layer,
// ╭───┬─────────┬─────────┬──────────┬──────────┬───╮  ╭──────────┬─────────┬──────────┬─────────┬──────────┬───╮
    __  __        __        __         __         __     &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR  &kp RBRC   __
// ├───┼─────────┼─────────┼──────────┼──────────┼───┤  ├──────────┼─────────┼──────────┼─────────┼──────────┼───┤
    __  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  __     &kp PLUS   &kp DLLR  &kp PRCT   &kp CRRT  &kp COLON  __
// ├───┼─────────┼─────────┼──────────┼──────────┼───┤  ├──────────┼─────────┼──────────┼─────────┼──────────┼───┤
    __  __        __        __         __         __     &kp PIPE   &kp EXCL  &kp AT     &kp HASH  &kp TILDE  __
// ╰───┴─────────┴─────────┼──────────┼──────────┼───┤  ├──────────┼─────────┼──────────┼─────────┴──────────┴───╯
                            __         __         __     &kp UNDER  &kp LPAR  &kp RPAR
//                         ╰──────────┴──────────┴───╯  ╰──────────┴─────────┴──────────╯
)

ZMK_LAYER(fun_layer,
// ╭───┬─────────┬─────────┬──────────┬──────────┬───╮  ╭────────────────┬────────┬──────────┬───────┬────────┬───╮
    __  __        __        __         __         __     &kp PSCRN        &kp F7   &kp F8     &kp F9  &kp F12  __
// ├───┼─────────┼─────────┼──────────┼──────────┼───┤  ├────────────────┼────────┼──────────┼───────┼────────┼───┤
    __  &kp LGUI  &kp LALT  &kp LCTRL  &kp LSHFT  __     &kp SLCK         &kp F4   &kp F5     &kp F6  &kp F11  __
// ├───┼─────────┼─────────┼──────────┼──────────┼───┤  ├────────────────┼────────┼──────────┼───────┼────────┼───┤
    __  __        __        __         __         __     &kp PAUSE_BREAK  &kp F1   &kp F2     &kp F3  &kp F10  __
// ╰───┴─────────┴─────────┼──────────┼──────────┼───┤  ├────────────────┼────────┼──────────┼───────┴────────┴───╯
                            __         __         __     &kp RET          &kp SPC  &kp K_APP
//                         ╰──────────┴──────────┴───╯  ╰────────────────┴────────┴──────────╯
)

ZMK_LAYER(gamingbase_layer,
// ╭──────────┬──────────┬──────────┬────────────┬────────────┬────────────╮  ╭─────────┬─────────┬─────────┬─────────┬─────────┬─────────╮
    &kp ESC    &kp SQT    &kp COMMA  &kp DOT      &kp P        &kp Y           &to BASE  &to BASE  &to BASE  &to BASE  &to BASE  &to BASE
// ├──────────┼──────────┼──────────┼────────────┼────────────┼────────────┤  ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &kp LSHFT  &kp A      &kp O      &kp E        &kp U        &kp I           &to BASE  &to BASE  &to BASE  &to BASE  &to BASE  &to BASE
// ├──────────┼──────────┼──────────┼────────────┼────────────┼────────────┤  ├─────────┼─────────┼─────────┼─────────┼─────────┼─────────┤
    &kp LCTRL  &kp SLASH  &kp Q      &kp J        &kp K        &kp X           &to BASE  &to BASE  &to BASE  &to BASE  &to BASE  &to BASE
// ╰──────────┴──────────┴──────────┼────────────┼────────────┼────────────┤  ├─────────┼─────────┼─────────┼─────────┴─────────┴─────────╯
                            __         __         __     &kp RET          &kp SPC  &kp K_APP
                                     // &lt FUN DEL  &mo Gaming1  &mo Gaming2     &to BASE  &to BASE  &to BASE
//                                  ╰────────────┴────────────┴────────────╯  ╰─────────┴─────────┴─────────╯
)


ZMK_LAYER(gaming1_layer,
// ╭────────────┬──────┬──────┬──────┬──────┬──────╮  ╭──────────┬──────────┬──────────┬──────────┬──────────┬───╮
    &kp TILDE    &kp L  &kp R  &kp C  &kp G  &kp F     &kp LBKT   &kp NUM_7  &kp NUM_8  &kp NUM_9  &kp RBKT   __
// ├────────────┼──────┼──────┼──────┼──────┼──────┤  ├──────────┼──────────┼──────────┼──────────┼──────────┼───┤
    &kp LS(TAB)  &kp S  &kp N  &kp T  &kp H  &kp D     &kp EQL    &kp NUM_4  &kp NUM_5  &kp NUM_6  &kp SEMI   __
// ├────────────┼──────┼──────┼──────┼──────┼──────┤  ├──────────┼──────────┼──────────┼──────────┼──────────┼───┤
    &kp LALT     &kp Z  &kp V  &kp W  &kp M  &kp B     &kp BSLH   &kp NUM_1  &kp NUM_2  &kp NUM_3  &kp GRAVE  __
// ╰────────────┴──────┴──────┼──────┼──────┼──────┤  ├──────────┼──────────┼──────────┼──────────┴──────────┴───╯
                               __     __     __        &kp MINUS  &kp NUM_0  &kp DOT
//                            ╰──────┴──────┴──────╯  ╰──────────┴──────────┴──────────╯
)

ZMK_LAYER(gaming2_layer,
// ╭───┬───────┬───────┬───────┬────────┬────────╮  ╭──────────┬─────────┬──────────┬─────────┬──────────┬───╮
    __  &kp N5  &kp N1  &kp N2  &kp N3   &kp N4      &kp LBRC   &kp AMPS  &kp ASTRK  &kp LPAR  &kp RBRC   __
// ├───┼───────┼───────┼───────┼────────┼────────┤  ├──────────┼─────────┼──────────┼─────────┼──────────┼───┤
    __  &kp N6  &kp N7  &kp N8  &kp N9   &kp N0      &kp PLUS   &kp DLLR  &kp PRCT   &kp CRRT  &kp COLON  __
// ├───┼───────┼───────┼───────┼────────┼────────┤  ├──────────┼─────────┼──────────┼─────────┼──────────┼───┤
    __  __      __      __      &kp TAB  &kp RET     &kp PIPE   &kp EXCL  &kp AT     &kp HASH  &kp TILDE  __
// ╰───┴───────┴───────┼───────┼────────┼────────┤  ├──────────┼─────────┼──────────┼─────────┴──────────┴───╯
                        __      __       __          &kp UNDER  &kp LPAR  &kp RPAR
//                     ╰───────┴────────┴────────╯  ╰──────────┴─────────┴──────────╯
)
