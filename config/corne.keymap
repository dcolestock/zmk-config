)

ZMK_LAYER(num_layer,
// ╭───┬─────────┬─────────┬──────────┬──────────┬────────────╮  ╭──────────┬──────────┬──────────┬──────────┬──────────┬───╮
    __  __        &kp DEL   &kp BKSP   &kp TAB    &kp LS(TAB)     &kp LBKT   &kp NUM_7  &kp NUM_8  &kp NUM_9  &kp RBKT   __
