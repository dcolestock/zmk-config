#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/ext_power.h>

#include "../zmk-nodefree-config/helper.h"
#include "../zmk-nodefree-config/keypos_def/keypos_42keys.h"

/* layer and key shortcuts */

#define __ &none

#define BASE 0  // layer shortcuts, must match order in which they are defined below
#define PUZZLE 1
#define OP 2
#define NAV 3
#define MEDIA 4
#define NUM 5
#define SYM 6
#define FUN 7
#define WORDS 8

/* custom behaviors */

#define KEYS_L LT0 LT1 LT2 LT3 LT4 LM0 LM1 LM2 LM3 LM4 LB0 LB1 LB2 LB3 LB4  // left-hand keys
#define KEYS_R RT0 RT1 RT2 RT3 RT4 RM0 RM1 RM2 RM3 RM4 RB0 RB1 RB2 RB3 RB4  // right-hand keys
#define THUMBS LH2 LH1 LH0 RH0 RH1 RH2                                      // thumb keys

#define MAKE_HRM(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_BEHAVIOR(NAME, hold_tap, \
        flavor = "balanced"; \
        tapping-term-ms = <280>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )

MAKE_HRM(hml, &kp, &kp, KEYS_R THUMBS)  // left-hand HRMs
MAKE_HRM(hmr, &kp, &kp, KEYS_L THUMBS)  // right-hand HRMs

#define MAKE_HRM_PINKY(NAME, HOLD, TAP, TRIGGER_POS) \
    ZMK_BEHAVIOR(NAME, hold_tap, \
        flavor = "tap-preferred"; \
        tapping-term-ms = <320>; \
        require-prior-idle-ms = <150>; \
        bindings = <HOLD>, <TAP>; \
        hold-trigger-key-positions = <TRIGGER_POS>; \
        hold-trigger-on-release; \
    )

MAKE_HRM_PINKY(hmlp, &kp, &kp, KEYS_R THUMBS)  // left-hand HRMs
MAKE_HRM_PINKY(hmrp, &kp, &kp, KEYS_L THUMBS)  // right-hand HRMs


#define MIRYOKU_SHIFT_FUNCTION(NAME, BINDING, SHIFT_BINDING) \
    ZMK_BEHAVIOR(NAME, mod_morph, \
        bindings = <BINDING>, <SHIFT_BINDING>; \
        mods = <(MOD_LSFT|MOD_RSFT)>; \
    )
MIRYOKU_SHIFT_FUNCTION(u_out_tog, &out OUT_TOG, &out OUT_USB)

#define MIRYOKU_SHIFT_MACRO(NAME, BINDING, SHIFT_BINDING) \
    ZMK_BEHAVIOR(u_macro_ ## NAME, macro, \
        wait-ms = <0>; \
        bindings = <SHIFT_BINDING>; \
    ) \
    MIRYOKU_SHIFT_FUNCTION(NAME, BINDING, &u_macro_ ## NAME)

MIRYOKU_SHIFT_MACRO(u_bt_sel_0, &bt BT_SEL 0, &bt BT_SEL 0 &bt BT_CLR)
MIRYOKU_SHIFT_MACRO(u_bt_sel_1, &bt BT_SEL 1, &bt BT_SEL 1 &bt BT_CLR)
MIRYOKU_SHIFT_MACRO(u_bt_sel_2, &bt BT_SEL 2, &bt BT_SEL 2 &bt BT_CLR)
MIRYOKU_SHIFT_MACRO(u_bt_sel_3, &bt BT_SEL 3, &bt BT_SEL 3 &bt BT_CLR)
MIRYOKU_SHIFT_MACRO(u_bt_sel_4, &bt BT_SEL 4, &bt BT_SEL 4 &bt BT_CLR)

MIRYOKU_SHIFT_FUNCTION(u_out_tog, &out OUT_TOG, &out OUT_USB)

MIRYOKU_SHIFT_FUNCTION(u_caps_word, &caps_word, &kp CAPS)

MIRYOKU_SHIFT_FUNCTION(u_rgb_tog, &rgb_ug RGB_TOG, &rgb_ug RGB_OFF)
MIRYOKU_SHIFT_FUNCTION(u_rgb_eff, &rgb_ug RGB_EFF, &rgb_ug RGB_EFR)
MIRYOKU_SHIFT_FUNCTION(u_rgb_hui, &rgb_ug RGB_HUI, &rgb_ug RGB_HUD)
MIRYOKU_SHIFT_FUNCTION(u_rgb_sai, &rgb_ug RGB_SAI, &rgb_ug RGB_SAD)
MIRYOKU_SHIFT_FUNCTION(u_rgb_bri, &rgb_ug RGB_BRI, &rgb_ug RGB_BRD)
MIRYOKU_SHIFT_FUNCTION(u_ep_tog, &ext_power EP_TOG, &ext_power EP_OFF)

/* combos */
#undef COMBO_TERM
#define COMBO_TERM 40  // timeout of 40ms (default is 30ms if omitted)
ZMK_COMBO(puzzle_layer, &to Puzzle, RT0 RT1, BASE)


/* macros */
ZMK_MACRO(sudoku, bindings = <&macro_tap &kp NUM_1 &kp NUM_2 &kp NUM_3 &kp NUM_4 &kp NUM_5 &kp NUM_6 &kp NUM_7 &kp NUM_8 &kp NUM_9>;)


ZMK_LAYER(base_layer,
// ╭───┬────────────┬────────────┬─────────────┬─────────────┬────────╮  ╭────────────┬─────────────┬─────────────┬────────────┬────────────┬───╮
    __  &kp SQT      &kp COMMA    &kp DOT       &kp P         &kp Y       &kp F        &kp G         &kp C         &kp R        &kp L        __
// ├───┼────────────┼────────────┼─────────────┼─────────────┼────────┤  ├────────────┼─────────────┼─────────────┼────────────┼────────────┼───┤
    __  &hmlp LGUI A  &hml LALT O  &hml LCTRL E  &hml LSHFT U  &kp I       &kp D        &hmr LSHFT H  &hmr LCTRL T  &hmr LALT N  &hmrp LGUI S  __
// ├───┼────────────┼────────────┼─────────────┼─────────────┼────────┤  ├────────────┼─────────────┼─────────────┼────────────┼────────────┼───┤
    &studio_unlock  &kp SLASH    &kp Q        &kp J         &kp K         &kp X       &kp B        &kp M         &kp W         &kp V        &kp Z        __
// ╰───┴────────────┴────────────┼─────────────┼─────────────┼────────┤  ├────────────┼─────────────┼─────────────┼────────────┴────────────┴───╯
                                  &lt FUN DEL   &lt NUM BKSP  &mo SYM     &key_repeat  &lt NAV SPC   &mo MEDIA
//                               ╰─────────────┴─────────────┴────────╯  ╰────────────┴─────────────┴─────────────╯
)

ZMK_LAYER(puzzle_layer,
// ╭───┬────────────┬────────────┬─────────────┬─────────────┬────────╮  ╭────────────┬─────────────┬─────────────┬────────────┬────────────┬───╮
    &to BASE  &kp PG_UP  &kp HOME   &kp UP     &kp END    &kp INS         &sudoku   &kp NUM_7  &kp NUM_8  &kp NUM_9  &to BASE   &to BASE
// ├───┼────────────┼────────────┼─────────────┼─────────────┼────────┤  ├────────────┼─────────────┼─────────────┼────────────┼────────────┼───┤
    &to BASE  &kp PG_DN  &kp LEFT   &kp DOWN   &kp RIGHT  &kp RET         &kp EQL    &kp NUM_4  &kp NUM_5  &kp NUM_6  &to BASE &to BASE
// ├───┼────────────┼────────────┼─────────────┼─────────────┼────────┤  ├────────────┼─────────────┼─────────────┼────────────┼────────────┼───┤
    &to BASE  &kp LC(Z)  &kp LC(X)  &kp LC(C)  &kp LC(V)  &kp LC(Y)       &kp BSLH   &kp NUM_1  &kp NUM_2  &kp NUM_3  &kp RET  &to BASE
// ╰───┴────────────┴────────────┼─────────────┼─────────────┼────────┤  ├────────────┼─────────────┼─────────────┼────────────┴────────────┴───╯
                                  &lt FUN DEL   &lt NUM BKSP  &mo SYM     &kp MINUS  &lt NAV NUM_0   &lt MEDIA DOT
//                               ╰─────────────┴─────────────┴────────╯  ╰────────────┴─────────────┴─────────────╯
)

